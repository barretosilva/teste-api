{
  "openapi": "3.0.0",
  "info": {
    "title": "Jitterbit Order API",
    "version": "1.0.0",
    "description": "API para gerenciamento de pedidos - Teste Jitterbit"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/order": {
      "post": {
        "summary": "Cria um novo pedido",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "numeroPedido": "v10089015vdb-01",
                  "valor Total": 10000,
                  "dataCriacao": "2023-07-19T12:24:11.5299601+00:00",
                  "items": [
                    { "idItem": "2434", "quantidadeltem": 1, "valorltem": 1000 }
                  ]
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Pedido criado" } }
      }
    },
    "/order/list": {
      "get": {
        "summary": "Lista todos os pedidos",
        "responses": { "200": { "description": "Lista de pedidos" } }
      }
    },
    "/order/{orderId}": {
      "get": {
        "summary": "Busca pedido por ID",
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Pedido encontrado" } }
      },
      "put": {
        "summary": "Atualiza um pedido",
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Pedido atualizado" } }
      },
      "delete": {
        "summary": "Deleta um pedido",
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Pedido deletado" } }
      }
    }
  }
}